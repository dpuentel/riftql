{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiftQL",
  "version": "0.5.3",
  "identifier": "com.riftql.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "RiftQL",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/riftql.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/riftql.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QUI5ODU4QkI4MkE2RkQKUldUOXBvSzdXSmlyR1FwbWh1T2RGN0Q1bkxmOGgxc2V3N1RNZVVQdGZPd3U5a1V1dUQ0dTRyZDgK",
      "endpoints": [
        "https://github.com/dpuentel/riftql/releases/latest/download/latest.json"
      ]
    }
  }
}