---
import meta from '../data/meta.json';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('starlight-theme');
          const metaEl = document.querySelector('meta[name="color-scheme"]');
          if (metaEl && (saved === 'dark' || saved === 'light')) {
            metaEl.setAttribute('content', saved);
          }
        } catch {
          // Ignore storage restrictions
        }
      })();
    </script>
    <title>RiftQL — The local-first API client for REST &amp; GraphQL</title>
    <meta
      name="description"
      content="Instant launch. Zero bloat. Local-first REST & GraphQL desktop API client built with Tauri v2, Rust, and React."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        color-scheme: light dark;

        &:has(> head > meta[name='color-scheme'][content='dark']) {
          color-scheme: dark;
        }
        &:has(> head > meta[name='color-scheme'][content='light']) {
          color-scheme: light;
        }

        --font-sans: 'Inter Variable', ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

        --bg-base: light-dark(#fafafa, #09090b);
        --bg-surface: light-dark(#ffffff, #121316);
        --bg-elevated: light-dark(#f4f4f5, #18191d);
        --bg-hover: light-dark(rgba(9, 9, 11, 0.045), rgba(244, 244, 245, 0.05));
        --border-subtle: light-dark(#e4e4e7, #27272a);
        --border-strong: light-dark(#d4d4d8, #3f3f46);
        --accent: light-dark(#7c3aed, #8b5cf6);
        --accent-hover: light-dark(#6d28d9, #7c3aed);
        --accent-muted: light-dark(rgba(124, 58, 237, 0.12), rgba(139, 92, 246, 0.16));
        --text-primary: light-dark(#09090b, #f4f4f5);
        --text-secondary: light-dark(#71717a, #a1a1aa);
        --text-tertiary: light-dark(#a1a1aa, #71717a);

        --sem-get: light-dark(#059669, #34d399);
        --sem-post: light-dark(#d97706, #fbbf24);
        --sem-put: light-dark(#2563eb, #60a5fa);
        --sem-gql: light-dark(#c026d3, #e879f9);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background-color: var(--bg-base);
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      :focus-visible {
        outline: 1.5px solid var(--accent);
        outline-offset: 2px;
      }

      .mono {
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .container {
        width: min(100% - 2rem, 70rem);
        margin-inline: auto;
      }

      /* Navbar */
      .nav {
        position: sticky;
        top: 0;
        z-index: 30;
        border-bottom: 1px solid var(--border-subtle);
        background-color: color-mix(in srgb, var(--bg-base) 88%, transparent);
        backdrop-filter: blur(10px);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 3.5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        font-weight: 600;
        font-size: 0.9375rem;
        letter-spacing: -0.015em;
      }

      .version-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.125rem 0.45rem;
        border-radius: 0.375rem;
        border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
        background: var(--accent-muted);
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 500;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      .nav-link {
        padding: 0.375rem 0.625rem;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        transition: color 0.15s, background-color 0.15s;
      }

      .nav-link:hover {
        color: var(--text-primary);
        background-color: var(--bg-hover);
      }

      .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-surface);
        color: var(--text-secondary);
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s, background-color 0.15s;
      }

      .icon-btn:hover {
        color: var(--text-primary);
        border-color: var(--border-strong);
        background: var(--bg-hover);
      }

      /* Pure CSS branching for dark-mode toggle icons (works with or without JS) */
      .icon-sun {
        display: none;
      }
      .icon-moon {
        display: inline-flex;
      }

      :root:has(> head > meta[name='color-scheme'][content='dark']) .icon-sun {
        display: inline-flex;
      }
      :root:has(> head > meta[name='color-scheme'][content='dark']) .icon-moon {
        display: none;
      }

      @media (prefers-color-scheme: dark) {
        :root:has(> head > meta[name='color-scheme'][content='light dark']) .icon-sun {
          display: inline-flex;
        }
        :root:has(> head > meta[name='color-scheme'][content='light dark']) .icon-moon {
          display: none;
        }
      }

      /* Hero */
      .hero {
        padding: 4.5rem 0 3.25rem;
        text-align: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        border: 1px solid var(--border-subtle);
        background: var(--bg-surface);
        color: var(--text-secondary);
        font-size: 0.75rem;
        font-weight: 500;
      }

      .eyebrow-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 9999px;
        background: var(--accent);
      }

      .hero h1 {
        margin: 1.25rem auto 0;
        max-width: 16ch;
        font-size: clamp(2.15rem, 5vw, 3.35rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.03em;
      }

      .hero-sub {
        margin: 1.125rem auto 0;
        max-width: 40rem;
        font-size: 1.0625rem;
        color: var(--text-secondary);
      }

      .hero-actions {
        margin-top: 2rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        height: 2.5rem;
        padding: 0 1.125rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
        transition: background-color 0.15s, border-color 0.15s, color 0.15s;
      }

      .btn-primary {
        background: var(--accent);
        color: #ffffff;
      }

      .btn-primary:hover {
        background: var(--accent-hover);
      }

      .btn-secondary {
        background: var(--bg-surface);
        border-color: var(--border-subtle);
        color: var(--text-primary);
      }

      .btn-secondary:hover {
        background: var(--bg-hover);
        border-color: var(--border-strong);
      }

      /* Workspace Preview Mockup */
      .preview-wrap {
        margin-top: 3rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-surface);
        overflow: hidden;
        text-align: left;
      }

      .preview-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border-subtle);
        background: var(--bg-base);
        font-size: 0.75rem;
      }

      .preview-tabs {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        overflow: hidden;
      }

      .preview-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.625rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-base);
        color: var(--text-secondary);
        white-space: nowrap;
      }

      .preview-tab.active {
        background: var(--bg-surface);
        border-color: var(--border-strong);
        color: var(--text-primary);
      }

      .preview-env {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.2rem 0.55rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-surface);
        color: var(--text-secondary);
      }

      .preview-body {
        display: grid;
        grid-template-columns: 15.5rem minmax(0, 1fr) minmax(0, 1fr);
        min-height: 19rem;
      }

      .preview-sidebar {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid var(--border-subtle);
        background: var(--bg-base);
        padding: 0.625rem;
        font-size: 0.75rem;
      }

      .tree-group-label {
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-tertiary);
        padding: 0.25rem 0.375rem;
      }

      .tree-item {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.3rem 0.5rem;
        border-radius: 0.375rem;
        color: var(--text-secondary);
      }

      .tree-item.indent {
        padding-left: 1.15rem;
      }

      .tree-item.selected {
        background: var(--accent-muted);
        color: var(--text-primary);
      }

      .sidebar-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.5rem;
        margin-top: 0.5rem;
        border-top: 1px solid var(--border-subtle);
        font-size: 0.6875rem;
        color: var(--text-secondary);
      }

      .status-dot {
        display: inline-block;
        width: 0.42rem;
        height: 0.42rem;
        border-radius: 9999px;
        background: var(--sem-get);
      }

      .preview-pane {
        padding: 0.75rem 0.875rem;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
      }

      .preview-pane + .preview-pane {
        border-left: 1px solid var(--border-subtle);
      }

      .url-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.375rem 0.625rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-base);
        font-size: 0.75rem;
      }

      .send-chip {
        padding: 0.15rem 0.55rem;
        border-radius: 0.3rem;
        background: var(--accent);
        color: #ffffff;
        font-weight: 500;
      }

      .resp-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
      }

      .badge-ok {
        padding: 0.125rem 0.45rem;
        border-radius: 0.3rem;
        border: 1px solid color-mix(in srgb, var(--sem-get) 35%, transparent);
        background: color-mix(in srgb, var(--sem-get) 12%, transparent);
        color: var(--sem-get);
        font-weight: 600;
      }

      .code-box {
        flex: 1;
        margin: 0;
        padding: 0.625rem 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-base);
        color: var(--text-primary);
        font-size: 0.75rem;
        line-height: 1.55;
        overflow-x: auto;
      }

      .m-get {
        color: var(--sem-get);
        font-weight: 600;
      }
      .m-post {
        color: var(--sem-post);
        font-weight: 600;
      }
      .m-put {
        color: var(--sem-put);
        font-weight: 600;
      }
      .m-gql {
        color: var(--sem-gql);
        font-weight: 600;
      }
      .c-key {
        color: var(--sem-put);
      }
      .c-str {
        color: var(--sem-get);
      }
      .c-kw {
        color: var(--accent);
      }

      @media (max-width: 860px) {
        .preview-body {
          grid-template-columns: 1fr;
        }
        .preview-sidebar {
          border-right: 0;
          border-bottom: 1px solid var(--border-subtle);
        }
        .preview-pane + .preview-pane {
          border-left: 0;
          border-top: 1px solid var(--border-subtle);
        }
      }

      /* Sections */
      .section {
        padding: 4rem 0;
        border-top: 1px solid var(--border-subtle);
      }

      .section-header {
        max-width: 38rem;
        margin-bottom: 2rem;
      }

      .section-header h2 {
        margin: 0;
        font-size: 1.625rem;
        letter-spacing: -0.02em;
      }

      .section-header p {
        margin: 0.5rem 0 0;
        color: var(--text-secondary);
        font-size: 0.9375rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      @media (max-width: 860px) {
        .grid-3 {
          grid-template-columns: 1fr;
        }
      }

      .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.25rem;
        border-radius: 0.625rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-surface);
      }

      .card h3 {
        margin: 0;
        font-size: 0.9375rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .card p {
        margin: 0;
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      .card-tag {
        display: inline-block;
        align-self: flex-start;
        padding: 0.125rem 0.45rem;
        border-radius: 0.3rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-elevated);
        color: var(--text-secondary);
        font-size: 0.6875rem;
      }

      .dl-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.75rem;
      }

      .dl-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-base);
        font-size: 0.8125rem;
        transition: border-color 0.15s, background-color 0.15s;
      }

      .dl-link:hover {
        border-color: var(--accent);
        background: var(--bg-hover);
      }

      .dl-badge {
        font-size: 0.6875rem;
        color: var(--sem-get);
      }

      .footer {
        padding: 2rem 0;
        border-top: 1px solid var(--border-subtle);
        font-size: 0.8125rem;
        color: var(--text-secondary);
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .footer-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      .footer-links a:hover {
        color: var(--text-primary);
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href="/" class="brand">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <defs>
              <clipPath id="nav-rift-clip">
                <rect x="2" y="2" width="28" height="28" rx="6.5" />
              </clipPath>
            </defs>
            <g clip-path="url(#nav-rift-clip)">
              <polygon points="2,2 21,2 9.5,30 2,30" fill="#18191D" />
              <polygon points="23.5,2 30,2 30,30 12,30" fill="#27272A" />
              <polygon points="20,2 24,2 12.5,30 8.5,30" fill="#8B5CF6" />
            </g>
            <rect x="2.5" y="2.5" width="27" height="27" rx="6" stroke="#3F3F46" stroke-width="1" />
          </svg>
          <span>RiftQL</span>
          <span class="version-pill mono" data-release-version>v{meta.version}</span>
        </a>

        <nav class="nav-links" aria-label="Primary navigation">
          <a href="#features" class="nav-link">Features</a>
          <a href="/docs/" class="nav-link">Docs</a>
          <a href="#download" class="nav-link">Download</a>
          <a
            href={meta.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="RiftQL on GitHub"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
              />
            </svg>
          </a>
          <button type="button" class="icon-btn" id="theme-toggle">
            <span class="icon-sun" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
              <span class="sr-only">Switch to light theme</span>
            </span>
            <span class="icon-moon" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
              <span class="sr-only">Switch to dark theme</span>
            </span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <span class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            Tauri v2 · Rust + React · Local-First &amp; Git Sync
          </span>
          <h1>The local-first API client for REST &amp; GraphQL.</h1>
          <p class="hero-sub">
            Instant launch. Zero bloat. Execute native Rust requests without CORS, auto-discover
            GraphQL schemas, keep secrets offline, and sync collections cleanly through Git.
          </p>

          <div class="hero-actions">
            <a href="#download" class="btn btn-primary" data-download-primary>
              Download RiftQL
            </a>
            <a href="/docs/" class="btn btn-secondary">Read Documentation</a>
          </div>

          <div class="preview-wrap" aria-label="RiftQL workspace interface preview">
            <div class="preview-topbar">
              <div class="preview-tabs mono">
                <span class="preview-tab active">
                  <span class="m-gql">GQL</span>
                  <span>GetUser</span>
                </span>
                <span class="preview-tab">
                  <span class="m-get">GET</span>
                  <span>/v1/health</span>
                </span>
                <span class="preview-tab">
                  <span class="m-put">PATCH</span>
                  <span>UpdateProfile</span>
                </span>
              </div>
              <span class="preview-env mono">Env: Production</span>
            </div>

            <div class="preview-body">
              <aside class="preview-sidebar mono">
                <div>
                  <div class="tree-group-label">Collections</div>
                  <div class="tree-item">Acme GraphQL API</div>
                  <div class="tree-item indent">AUTO-DISCOVERED</div>
                  <div class="tree-item indent selected">
                    <span class="m-gql">GQL</span>
                    <span>user</span>
                  </div>
                  <div class="tree-item indent">
                    <span class="m-gql">GQL</span>
                    <span>listOrders</span>
                  </div>
                  <div class="tree-item indent">
                    <span class="m-post">POST</span>
                    <span>createSession</span>
                  </div>
                </div>
                <div class="sidebar-footer">
                  <span><span class="status-dot"></span> Cookies (3)</span>
                  <span><span class="status-dot"></span> main</span>
                </div>
              </aside>

              <div class="preview-pane">
                <div class="url-bar mono">
                  <span><span class="m-gql">GQL</span> https://api.acme.dev/graphql</span>
                  <span class="send-chip">Send ⌘↵</span>
                </div>
                <pre class="code-box mono"><span class="c-kw">query</span> GetUser($id: ID!) &#123;
  user(id: $id) &#123;
    id
    name
    email
    role
  &#125;
&#125;</pre>
              </div>

              <div class="preview-pane">
                <div class="resp-meta mono">
                  <span class="badge-ok">200 OK</span>
                  <span>42 ms</span>
                  <span>1.8 KB</span>
                  <span>application/json</span>
                </div>
                <pre class="code-box mono">&#123;
  <span class="c-key">"data"</span>: &#123;
    <span class="c-key">"user"</span>: &#123;
      <span class="c-key">"id"</span>: <span class="c-str">"usr_01J9RIFT"</span>,
      <span class="c-key">"name"</span>: <span class="c-str">"Ada Lovelace"</span>,
      <span class="c-key">"role"</span>: <span class="c-str">"ADMIN"</span>
    &#125;
  &#125;
&#125;</pre>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="section">
        <div class="container">
          <div class="section-header">
            <h2>Built for speed, privacy, and keyboard focus</h2>
            <p>
              Combines REST ergonomics, native GraphQL introspection, and clean Git diffs in one
              compact native desktop binary.
            </p>
          </div>

          <div class="grid-3">
            <article class="card">
              <span class="card-tag mono">Rust HTTP</span>
              <h3>Native Reqwest + Cookie Jar</h3>
              <p>
                Zero browser CORS limits. Supports custom TLS checks, redirects, timeouts,
                in-flight cancellation, streaming multipart uploads, and an RFC 6265 Cookie Jar.
              </p>
            </article>

            <article class="card">
              <span class="card-tag mono">GraphQL AST</span>
              <h3>Schema Docs &amp; Auto-Discovery</h3>
              <p>
                CodeMirror 6 + cm6-graphql autocomplete and linting, searchable Schema Docs, and
                AST discovery generating missing operations under AUTO-DISCOVERED.
              </p>
            </article>

            <article class="card">
              <span class="card-tag mono">Hierarchy</span>
              <h3>Base URL &amp; Auth Inheritance</h3>
              <p>
                Compose Base URLs and Auth across collections, nested folders, and requests with
                Active Env &gt; Collection &gt; Global precedence and bulk variable keys.
              </p>
            </article>

            <article class="card">
              <span class="card-tag mono">Importers</span>
              <h3>Altair, Postman, Insomnia, OpenAPI</h3>
              <p>
                Import .agq/.agc/.agx files, Postman v2 collections and environments, Insomnia v4,
                OpenAPI 3.x / Swagger 2.0, and cURL; generate ready-to-run code snippets.
              </p>
            </article>

            <article class="card">
              <span class="card-tag mono">Local + Git Sync</span>
              <h3>Deterministic JSON &amp; Local Secrets</h3>
              <p>
                Fast SQLite database plus optional Git-diffable JSON mirror with debounced Auto-Push
                and Auto-Fetch alerts. Secrets stay exclusively in SQLite and .riftql.secrets.json.
              </p>
            </article>

            <article class="card">
              <span class="card-tag mono">Keyboard UX</span>
              <h3>Command Palette &amp; Auto-Updates</h3>
              <p>
                Navigate everything with Ctrl/Cmd+K, remap shortcuts with conflict detection, scale
                typography independently, and install signed updates directly from GitHub Releases.
              </p>
            </article>
          </div>
        </div>
      </section>

