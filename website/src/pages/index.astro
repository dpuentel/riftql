    <script is:inline define:vars={{ releasesUrl: meta.releasesUrl }}>
      (() => {
        const THEME_KEY = 'starlight-theme';
        const getSystemScheme = () =>
          window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const applyScheme = (scheme) => {
          const metaEl = document.querySelector('meta[name="color-scheme"]');
          if (!metaEl) return;
          metaEl.setAttribute('content', scheme === 'dark' || scheme === 'light' ? scheme : 'light dark');
        };

        const toggleBtn = document.getElementById('theme-toggle');
        toggleBtn?.addEventListener('click', () => {
          const system = getSystemScheme();
          let stored = null;
          try {
            stored = localStorage.getItem(THEME_KEY);
          } catch {
            stored = null;
          }
          const rendered = stored === 'dark' || stored === 'light' ? stored : system;
          const target = rendered === 'dark' ? 'light' : 'dark';
          try {
            if (target !== system) {
              localStorage.setItem(THEME_KEY, target);
              applyScheme(target);
            } else {
              localStorage.removeItem(THEME_KEY);
              applyScheme('light dark');
            }
          } catch {
            applyScheme(target);
          }
        });

        window.addEventListener('storage', (ev) => {
          if (ev.key === THEME_KEY) {
            applyScheme(ev.newValue);
          }
        });

        // OS-aware primary CTA label
        const primaryBtn = document.querySelector('[data-download-primary]');
        const ua = navigator.userAgent.toLowerCase();
        const isArmMac = ua.includes('mac') && navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1;
        let detectedKey = null;
        if (ua.includes('win')) {
          detectedKey = 'win-exe';
          if (primaryBtn) primaryBtn.textContent = 'Download for Windows';
        } else if (ua.includes('mac')) {
          detectedKey = isArmMac ? 'mac-arm' : 'mac-arm';
          if (primaryBtn) primaryBtn.textContent = 'Download for macOS';
        } else if (ua.includes('linux')) {
          detectedKey = 'linux-appimage';
          if (primaryBtn) primaryBtn.textContent = 'Download AppImage for Linux';
        }

        const hydrateReleaseLinks = async () => {
          const CACHE_KEY = 'riftql-latest-release-cache';
          let release = null;
          try {
            const cached = sessionStorage.getItem(CACHE_KEY);
            if (cached) {
              const parsed = JSON.parse(cached);
              if (Date.now() - parsed.ts < 15 * 60 * 1000) {
                release = parsed.data;
              }
            }
          } catch {
            // ignore cache error
          }

          if (!release) {
            try {
              const res = await fetch('https://api.github.com/repos/dpuentel/riftql/releases/latest', {
                headers: { Accept: 'application/vnd.github+json' },
              });
              if (!res.ok) return;
              release = await res.json();
              try {
                sessionStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data: release }));
              } catch {
                // ignore cache error
              }
            } catch {
              return;
            }
          }

          if (!release || !Array.isArray(release.assets)) return;
          if (typeof release.tag_name === 'string' && release.tag_name) {
            document.querySelectorAll('[data-release-version]').forEach((el) => {
              el.textContent = release.tag_name.startsWith('v')
                ? release.tag_name
                : `v${release.tag_name}`;
            });
          }

          const findAsset = (re) =>
            release.assets.find((a) => typeof a.name === 'string' && re.test(a.name))
              ?.browser_download_url;

          const urlByKey = {
            'win-exe': findAsset(/-setup\.exe$/i),
            'win-msi': findAsset(/\.msi$/i),
            'linux-appimage': findAsset(/\.AppImage$/i),
            'linux-deb': findAsset(/\.deb$/i),
            'linux-rpm': findAsset(/\.rpm$/i),
            'mac-arm': findAsset(/aarch64.*\.dmg$/i),
            'mac-x64': findAsset(/x64.*\.dmg$/i),
          };

          document.querySelectorAll('[data-asset-key]').forEach((link) => {
            const key = link.getAttribute('data-asset-key');
            if (key && urlByKey[key]) {
              link.setAttribute('href', urlByKey[key]);
            } else {
              link.setAttribute('href', release.html_url || releasesUrl);
            }
          });

          if (primaryBtn && detectedKey && urlByKey[detectedKey]) {
            primaryBtn.setAttribute('href', urlByKey[detectedKey]);
          }
        };

        void hydrateReleaseLinks();
      })();
    </script>
  </body>
</html>
